# รหัสผ่านผู้ดูแลระบบ (Admin PIN) สำหรับปลดล็อกหน้าจัดการบุคลากรและการแก้ไข/ลบ
VITE_ADMIN_PIN=""

# Firebase Web App Configuration (สำหรับระบบ Sign-in with Google และเชื่อมต่อ Google Sheets API)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""

# Optional: Gemini API Key & App URL (เฉพาะกรณีรันผ่านเซิร์ฟเวอร์ AI Studio)
GEMINI_API_KEY=""
APP_URL=""
